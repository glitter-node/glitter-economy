{
  "version": "1.0.0",
  "layout_name": "user_glitter_economy_wallet",
  "permissions": ["glitter-economy.wallet.view"],
  "extends": "_user_base",
  "meta": {
    "title": "$t:glitter-economy.user.wallet.title",
    "description": "$t:glitter-economy.user.wallet.description"
  },
  "data_sources": [
    {
      "id": "wallet",
      "type": "api",
      "endpoint": "/api/modules/glitter-economy/user/wallet",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true,
      "loading_strategy": "progressive",
      "errorHandling": {
        "401": { "handler": "showErrorPage", "params": { "target": "content" } },
        "403": { "handler": "showErrorPage", "params": { "target": "content" } }
      }
    },
    {
      "id": "transactions",
      "type": "api",
      "endpoint": "/api/modules/glitter-economy/user/transactions",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true,
      "loading_strategy": "progressive",
      "errorHandling": {
        "401": { "handler": "showErrorPage", "params": { "target": "content" } },
        "403": { "handler": "showErrorPage", "params": { "target": "content" } }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "user_wallet_content",
        "type": "basic",
        "name": "Div",
        "props": { "className": "min-h-screen bg-gray-50 dark:bg-gray-900 px-4 py-8 sm:px-6 lg:px-8" },
        "children": [
          {
            "id": "user_wallet_inner",
            "type": "basic",
            "name": "Div",
            "props": { "className": "mx-auto max-w-5xl" },
            "children": [
              {
                "id": "user_wallet_header",
                "type": "basic",
                "name": "Div",
                "children": [
                  {
                    "type": "basic",
                    "name": "H1",
                    "props": { "className": "text-2xl font-bold text-gray-900 dark:text-white" },
                    "text": "$t:glitter-economy.user.wallet.title"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": { "className": "mt-2 text-sm text-gray-600 dark:text-gray-300" },
                    "text": "$t:glitter-economy.user.wallet.description"
                  }
                ]
              },
              {
                "id": "user_wallet_summary",
                "type": "basic",
                "name": "Div",
                "blur_until_loaded": true,
                "props": { "className": "mt-6 grid grid-cols-1 gap-4 md:grid-cols-3" },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800" },
                    "children": [
                      { "type": "basic", "name": "Span", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.balance" },
                      { "type": "basic", "name": "P", "props": { "className": "mt-2 text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "{{wallet?.data?.balance ?? '0.00'}}" }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800" },
                    "children": [
                      { "type": "basic", "name": "Span", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.locked_balance" },
                      { "type": "basic", "name": "P", "props": { "className": "mt-2 text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "{{wallet?.data?.locked_balance ?? '0.00'}}" }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800" },
                    "children": [
                      { "type": "basic", "name": "Span", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.available_balance" },
                      { "type": "basic", "name": "P", "props": { "className": "mt-2 text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "{{wallet?.data?.available_balance ?? '0.00'}}" }
                    ]
                  }
                ]
              },
              {
                "id": "user_wallet_meta",
                "type": "basic",
                "name": "Div",
                "blur_until_loaded": true,
                "props": { "className": "mt-4 rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800" },
                "children": [
                  { "type": "basic", "name": "H2", "props": { "className": "text-base font-semibold text-gray-900 dark:text-white" }, "text": "$t:glitter-economy.user.wallet.wallet_status" },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3" },
                    "children": [
                      { "type": "basic", "name": "Div", "children": [ { "type": "basic", "name": "Span", "props": { "className": "text-xs text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.wallet_type" }, { "type": "basic", "name": "P", "props": { "className": "mt-1 text-sm font-medium text-gray-900 dark:text-white" }, "text": "{{wallet?.data?.wallet_type ?? ''}}" } ] },
                      { "type": "basic", "name": "Div", "children": [ { "type": "basic", "name": "Span", "props": { "className": "text-xs text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.currency_code" }, { "type": "basic", "name": "P", "props": { "className": "mt-1 text-sm font-medium text-gray-900 dark:text-white" }, "text": "{{wallet?.data?.currency_code ?? ''}}" } ] },
                      { "type": "basic", "name": "Div", "children": [ { "type": "basic", "name": "Span", "props": { "className": "text-xs text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.status" }, { "type": "basic", "name": "P", "props": { "className": "mt-1 text-sm font-medium text-gray-900 dark:text-white" }, "text": "{{wallet?.data?.status ?? ''}}" } ] }
                    ]
                  }
                ]
              },
              {
                "id": "user_wallet_transactions",
                "type": "basic",
                "name": "Div",
                "props": { "className": "mt-6" },
                "children": [
                  { "type": "basic", "name": "H2", "props": { "className": "text-lg font-semibold text-gray-900 dark:text-white" }, "text": "$t:glitter-economy.user.transactions.title" },
                  {
                    "id": "user_wallet_transaction_cards",
                    "type": "composite",
                    "name": "CardGrid",
                    "blur_until_loaded": true,
                    "props": {
                      "data": "{{transactions?.data ?? []}}",
                      "gridColumns": 1,
                      "gap": 3,
                      "emptyMessage": "$t:glitter-economy.user.transactions.empty",
                      "cardClassName": "rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800",
                      "cardColumns": [
                        {
                          "id": "user_wallet_transaction_card",
                          "cellChildren": [
                            {
                              "type": "basic",
                              "name": "Div",
                              "props": { "className": "grid grid-cols-1 gap-3 md:grid-cols-4 md:items-center" },
                              "children": [
                                { "type": "basic", "name": "Div", "children": [ { "type": "basic", "name": "Span", "props": { "className": "text-xs text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.transaction_type" }, { "type": "basic", "name": "P", "props": { "className": "mt-1 text-sm font-semibold text-gray-900 dark:text-white" }, "text": "{{row.transaction_type}}" } ] },
                                { "type": "basic", "name": "Div", "children": [ { "type": "basic", "name": "Span", "props": { "className": "text-xs text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.amount" }, { "type": "basic", "name": "P", "props": { "className": "mt-1 text-sm font-semibold text-gray-900 dark:text-white" }, "text": "{{row.amount}}" } ] },
                                { "type": "basic", "name": "Div", "children": [ { "type": "basic", "name": "Span", "props": { "className": "text-xs text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.balance_after" }, { "type": "basic", "name": "P", "props": { "className": "mt-1 text-sm font-medium text-gray-900 dark:text-white" }, "text": "{{row.balance_after}}" } ] },
                                { "type": "basic", "name": "Div", "children": [ { "type": "basic", "name": "Span", "props": { "className": "text-xs text-gray-500 dark:text-gray-400" }, "text": "$t:glitter-economy.user.fields.occurred_at" }, { "type": "basic", "name": "P", "props": { "className": "mt-1 text-sm font-mono text-gray-900 dark:text-white" }, "text": "{{row.occurred_at}}" } ] }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
